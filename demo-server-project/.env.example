# =============================================================================
# demo-server configuration — copy to .env and fill in
# =============================================================================
# Every configurable value comes from the environment or this file. Variables
# exported in the shell override values here (empty exports are ignored).
# Legacy `CYBERGUARD_*` aliases (shown in brackets) are still accepted; the
# primary name wins if both are set.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Slug of the CyberGuard project to ship as (Project Settings -> API Keys
# shows it next to the gateway row: POST /api/v1/p/{slug}/gateway).
# [legacy alias: CYBERGUARD_PROJECT_SLUG]
PROJECT_SLUG=your-project-slug

# Gateway API key. Set exactly ONE of these two — never both, never commit.
# The plaintext master key is shown ONCE when issued; prefer KEY_FILE on
# shared machines. [legacy aliases: CYBERGUARD_MASTER_KEY / CYBERGUARD_KEY_FILE]
#MASTER_API_KEY=<paste-the-plaintext-key>
#KEY_FILE=/secure/path/gateway.key

# --- Gateway connection ------------------------------------------------------

# Base URL of the CyberGuard backend API. The gateway endpoint used is
# {GATEWAY_URL}/p/{slug}/gateway, so the /api/v1 prefix belongs here.
# [legacy alias: CYBERGUARD_GATEWAY_URL]
GATEWAY_URL=http://localhost:8000/api/v1

# Per-request timeout in seconds.
SHIP_TIMEOUT_S=10

# Retries on 5xx / transport errors only (exponential backoff, 4xx never
# retried).
SHIP_MAX_RETRIES=3

# --- Traffic generator (`generate` command and /traffic/start) ---------------

# Default traffic rate when --rate is omitted (payloads per minute).
DEFAULT_RATE=10

# Default run length when --duration is omitted (minutes).
DEFAULT_DURATION=60

# --- Campaigns ---------------------------------------------------------------

# Default stage-delay multiplier for `campaign run` when --timescale is
# omitted (1.0 = real time, 0.5 = twice as fast).
DEFAULT_TIMESCALE=1.0

# Directory holding the campaign JSON definitions (cred_stuffing.json,
# c2_beacon_wave.json, exfil_spike.json, apt_mixed.json). A relative
# "./campaigns" is looked up in the working directory first, then the
# demo-server-project root.
CAMPAIGNS_DIR=./campaigns

# Directory where `campaign run` writes its JSON run reports (created on
# demand).
REPORTS_DIR=./data/campaign_reports

# --- Local service / storage -------------------------------------------------

# Port for `demo-server serve` (FastAPI control API).
DEMO_PORT=8020

# SQLite store recording every gateway attempt (request, response, latency,
# error). Never contains key material.
STORE_PATH=data/responses.db
