# ==============================================================================
# CYBERGUARD — Docker Compose (production) environment
# ==============================================================================
# Copy to .env next to docker-compose.prod.yml and fill in BEFORE `up`:
#   cp .env.example .env
# Compose reads this file for ${VAR} interpolation; the backend has its own
# backend/.env (see backend/.env.example) that the api/workers load via env_file.

# --- Internal service credentials (generate strong values!) -------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-postgres-password
# openssl rand -hex 24
REDIS_PASSWORD=change-me-strong-redis-password

# --- Frontend build args (baked into the SPA at build time) -------------------
# Same values you use in frontend/.env.local
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Optional: pgAdmin GUI (localhost-only, use an ssh tunnel) ----------------
PGADMIN_EMAIL=admin@cyberguard.org
PGADMIN_PASSWORD=change-me-pgadmin-password
