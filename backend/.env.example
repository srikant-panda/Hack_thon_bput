# ==============================================================================
# CyberGuard Backend Environment Configuration
# ==============================================================================

# FastAPI Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="CyberGuard AI SOAR"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (SQLAlchemy 2.0 Async)
# Default SQLite async local file:
DATABASE_URL=sqlite+aiosqlite:///./cyberguard.db
# Or PostgreSQL asyncpg for production:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cyberguard

# Supabase Configuration (Authentication, RBAC & Cloud Storage)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=cyberguard-media

# Local Media Storage Fallback (used when Supabase storage is offline)
MEDIA_STORAGE_DIR=./uploads

# ==============================================================================
# Multi-Provider Distributed LLM Engine & Key Rotation
# Supports Groq, Gemini, and OpenRouter (OpenAI & Anthropic excluded by design)
# All keys are completely optional: missing keys log cleanly during startup and
# the system automatically operates in deterministic heuristic explanation mode.
# ==============================================================================

# Active providers to include in distributed round-robin pool:
LLM_PROVIDERS=groq,gemini,openrouter
LLM_COOLDOWN_SECONDS=60
LLM_HEALTH_CHECK_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# 1. Groq (Ultra-low latency inference: Llama 3.3 70B, Llama 3.1 8B, Mixtral)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# OR multiple keys (comma-separated or GROQ_API_KEY_1..N up to GROQ_MAX_KEYS):
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_MAX_KEYS=10
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 2. Google Gemini (Google GenAI: Gemini 2.0 Flash, Gemini 1.5 Flash)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# OR multiple keys (comma-separated or GEMINI_API_KEY_1..N up to GEMINI_MAX_KEYS):
# GEMINI_API_KEYS=gemini_key1,gemini_key2
# Also supports standard GOOGLE_API_KEY
GEMINI_MAX_KEYS=10
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. OpenRouter (Multi-model gateway)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
# OR multiple keys:
# OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_MAX_KEYS=10
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,nex-agi/nex-n2.5-mini:free


