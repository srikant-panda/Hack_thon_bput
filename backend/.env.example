# ==============================================================================
# CyberGuard Backend Environment Configuration
# ==============================================================================

# FastAPI Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="CyberGuard AI SOAR"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (SQLAlchemy 2.0 Async)
# Default SQLite async local file:
DATABASE_URL=sqlite+aiosqlite:///./cyberguard.db
# Or PostgreSQL asyncpg for production:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cyberguard

# Supabase Configuration (Authentication, RBAC & Cloud Storage)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=cyberguard-media

# Local Media Storage Fallback (used when Supabase storage is offline)
MEDIA_STORAGE_DIR=./uploads

# ==============================================================================
# OpenRouter Distributed API Key Rotation & Circuit Breaker Engine
# ==============================================================================
# Single primary key:
OPENROUTER_API_KEY=your-openrouter-api-key

# OR Comma-separated list of multiple keys for distributed load balancing:
# OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3

# OR individual numbered environment variables:
# OPENROUTER_API_KEY_1=sk-or-v1-key1
# OPENROUTER_API_KEY_2=sk-or-v1-key2
# OPENROUTER_API_KEY_3=sk-or-v1-key3

# Maximum keys to load into active rotation pool (Default: 10, configurable from env)
OPENROUTER_MAX_KEYS=10

# Circuit breaker cooldown (seconds) after key failure/rate limit (429/401/402)
OPENROUTER_KEY_COOLDOWN_SECONDS=60

# Background health check interval (seconds) to probe & re-release recovered keys
OPENROUTER_HEALTH_CHECK_INTERVAL_SECONDS=30

# Default LLM Model
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

